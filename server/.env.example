# 环境变量模板 —— 复制成 .env 再填值
#
#   cp server/.env.example server/.env
#   chmod 600 server/.env
#
# 注意：.env 已被 .gitignore 排除，**不要**提交真实值。
# ecosystem.config.js 会读这个文件，优先级是 .env > 进程环境变量 > 配置默认值。

# 访问令牌（必填）。
# 生成一个：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 手机端在「我的 → 高级设置 → 访问令牌」里填同一个值。
AUTH_TOKEN=

# Node 监听端口（可选，默认 3458）。
# ⚠️ 这是 Node 内部端口，不是 Nginx 对外的 3457。
PORT=3458

# CORS 白名单，逗号分隔（可选）。
# 只有「从别的域名打开页面、却要连这台服务器」才需要配。
# 手机直接开 https://nexus.kotete.xyz 属于同源，用不到。
CORS_ORIGIN=https://nexus.kotete.xyz,https://kotete.xyz,https://kotete.xyz:908,http://kotete.xyz:908,http://8.134.190.49:908

# 以下一般不用改，留空就用代码里的默认值：
# DB_PATH=/root/nexus-core/server/journal.db
# DATA_DIR=/root/nexus-core/server/data
# REPORT_DIR=/root/nexus-core/report
# BACKUP_DIR=/root/backups
# OLLAMA_URL=http://localhost:11434
